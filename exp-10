from itertools import permutations
def tarveling_salesman(graph,start):
    cities=list(range(len(graph)))
    cities.remove(start)
    min_cost=float('inf')
    best_path=None
    for prem in permutations(cities):
        current_cost=0
        current_path=[start]
        k=start
        for city in prem:
            current_cost+= graph[k][city]
            current_path.append(city)
            k=city
        current_cost+=graph[k][start]
        current_path.append(start)

        if current_cost<min_cost:
            min_cost=current_cost
            best_path=current_path
    return best_path,min_cost

n=int(input("enter the number of cities:"))
print("enter the cost matrrix:")
graph=[]
for i in range(n):
    row=list(map(int, input().split()))
    graph.append(row)

start=int(input("enter the starting city (0 to {}):".format(n-1)))
path,cost=tarveling_salesman(graph,start)
print("\noptimal path:", " -> ".join(map(str,path)))
print("miminum cost:",cost)